@page "/veganplaceduylds/details"
@using Microsoft.EntityFrameworkCore
@using Vegan.Entities.DuyLD.Models
@inject IDbContextFactory<Vegan.Entities.DuyLD.Models.VeganDBContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>VeganPlaceDuyLd</h2>
    <hr />
    @if (veganplaceduyld is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">CategoryName</dt>
            <dd class="col-sm-10">@veganplaceduyld.CategoryName</dd>
            <dt class="col-sm-2">CategoryDescription</dt>
            <dd class="col-sm-10">@veganplaceduyld.CategoryDescription</dd>
            <dt class="col-sm-2">CategoryDisplayOrder</dt>
            <dd class="col-sm-10">@veganplaceduyld.CategoryDisplayOrder</dd>
            <dt class="col-sm-2">PlaceName</dt>
            <dd class="col-sm-10">@veganplaceduyld.PlaceName</dd>
            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@veganplaceduyld.Address</dd>
            <dt class="col-sm-2">Phone</dt>
            <dd class="col-sm-10">@veganplaceduyld.Phone</dd>
            <dt class="col-sm-2">Website</dt>
            <dd class="col-sm-10">@veganplaceduyld.Website</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@veganplaceduyld.Description</dd>
            <dt class="col-sm-2">Latitude</dt>
            <dd class="col-sm-10">@veganplaceduyld.Latitude</dd>
            <dt class="col-sm-2">Longitude</dt>
            <dd class="col-sm-10">@veganplaceduyld.Longitude</dd>
            <dt class="col-sm-2">Rating</dt>
            <dd class="col-sm-10">@veganplaceduyld.Rating</dd>
            <dt class="col-sm-2">CreatedAt</dt>
            <dd class="col-sm-10">@veganplaceduyld.CreatedAt</dd>
            <dt class="col-sm-2">IsActive</dt>
            <dd class="col-sm-10">@veganplaceduyld.IsActive</dd>
        </dl>
        <div>
            <a href="@($"/veganplaceduylds/edit?veganplaceduyldid={veganplaceduyld.VeganPlaceDuyLdid}")">Edit</a> |
            <a href="@($"/veganplaceduylds")">Back to List</a>
        </div>
    }
</div>

@code {
    private VeganPlaceDuyLd? veganplaceduyld;

    [SupplyParameterFromQuery]
    private long VeganPlaceDuyLdid { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        veganplaceduyld = await context.VeganPlaceDuyLds.FirstOrDefaultAsync(m => m.VeganPlaceDuyLdid == VeganPlaceDuyLdid);

        if (veganplaceduyld is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
