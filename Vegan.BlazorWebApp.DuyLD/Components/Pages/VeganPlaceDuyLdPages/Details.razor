@page "/veganplaceduylds/details"
@attribute [Authorize]
@using Vegan.Entities.DuyLD.Models
@using Vegan.Services.DuyLD

@inject IVeganPlaceServiceDuyLd VeganPlaceService
@inject NavigationManager NavigationManager

<PageTitle>Vegan Place Details</PageTitle>

<h1>Details</h1>
<h4>Vegan Place</h4>
<hr />

@if (veganPlace is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Category Name</dt><dd class="col-sm-9">@veganPlace.CategoryName</dd>
        <dt class="col-sm-3">Category Description</dt><dd class="col-sm-9">@veganPlace.CategoryDescription</dd>
        <dt class="col-sm-3">Display Order</dt><dd class="col-sm-9">@veganPlace.CategoryDisplayOrder</dd>
        <dt class="col-sm-3">Place Name</dt><dd class="col-sm-9">@veganPlace.PlaceName</dd>
        <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@veganPlace.Address</dd>
        <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@veganPlace.Phone</dd>
        <dt class="col-sm-3">Website</dt><dd class="col-sm-9">@veganPlace.Website</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@veganPlace.Description</dd>
        <dt class="col-sm-3">Latitude</dt><dd class="col-sm-9">@veganPlace.Latitude</dd>
        <dt class="col-sm-3">Longitude</dt><dd class="col-sm-9">@veganPlace.Longitude</dd>
        <dt class="col-sm-3">Rating</dt><dd class="col-sm-9">@veganPlace.Rating</dd>
        <dt class="col-sm-3">Created At</dt><dd class="col-sm-9">@veganPlace.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(veganPlace.IsActive ? "Active" : "Inactive")</dd>
    </dl>

    <a class="btn btn-outline-secondary" href="veganplaceduylds">Back to List</a>
}

@code {
    [SupplyParameterFromQuery]
    private long veganplaceduyldid { get; set; }

    private VeganPlaceDuyLd? veganPlace;

    protected override async Task OnInitializedAsync()
    {
        veganPlace = await VeganPlaceService.GetByIdAsync(veganplaceduyldid);

        if (veganPlace is null)
        {
            NavigationManager.NavigateTo("/veganplaceduylds");
        }
    }
}

