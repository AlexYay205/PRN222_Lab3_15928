@page "/veganplaceduylds/edit"
@attribute [Authorize]
@using Vegan.Entities.DuyLD.Models
@using Vegan.Services.DuyLD

@inject IVeganPlaceServiceDuyLd VeganPlaceService
@inject NavigationManager NavigationManager

<PageTitle>Edit Vegan Place</PageTitle>

<h1>Edit</h1>
<h4>Vegan Place</h4>
<hr />

@if (veganPlace is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="veganPlace" OnValidSubmit="UpdateAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3"><label class="form-label">Category Name</label><InputText class="form-control" @bind-Value="veganPlace.CategoryName" /></div>
                <div class="mb-3"><label class="form-label">Category Description</label><InputText class="form-control" @bind-Value="veganPlace.CategoryDescription" /></div>
                <div class="mb-3"><label class="form-label">Display Order</label><InputNumber class="form-control" @bind-Value="veganPlace.CategoryDisplayOrder" /></div>
                <div class="mb-3"><label class="form-label">Place Name</label><InputText class="form-control" @bind-Value="veganPlace.PlaceName" /></div>
                <div class="mb-3"><label class="form-label">Address</label><InputText class="form-control" @bind-Value="veganPlace.Address" /></div>
                <div class="mb-3"><label class="form-label">Phone</label><InputText class="form-control" @bind-Value="veganPlace.Phone" /></div>
                <div class="mb-3"><label class="form-label">Website</label><InputText class="form-control" @bind-Value="veganPlace.Website" /></div>
                <div class="mb-3"><label class="form-label">Description</label><InputText class="form-control" @bind-Value="veganPlace.Description" /></div>
                <div class="mb-3"><label class="form-label">Latitude</label><InputNumber class="form-control" @bind-Value="veganPlace.Latitude" /></div>
                <div class="mb-3"><label class="form-label">Longitude</label><InputNumber class="form-control" @bind-Value="veganPlace.Longitude" /></div>
                <div class="mb-3"><label class="form-label">Rating</label><InputNumber class="form-control" @bind-Value="veganPlace.Rating" /></div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="veganPlace.IsActive" />
                    <label class="form-check-label">Active</label>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="veganplaceduylds">Back to List</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private long veganplaceduyldid { get; set; }

    private VeganPlaceDuyLd? veganPlace;

    protected override async Task OnInitializedAsync()
    {
        veganPlace = await VeganPlaceService.GetByIdAsync(veganplaceduyldid);

        if (veganPlace is null)
        {
            NavigationManager.NavigateTo("/veganplaceduylds");
        }
    }

    private async Task UpdateAsync()
    {
        await VeganPlaceService.UpdateAsync(veganPlace!);
        NavigationManager.NavigateTo("/veganplaceduylds");
    }
}

