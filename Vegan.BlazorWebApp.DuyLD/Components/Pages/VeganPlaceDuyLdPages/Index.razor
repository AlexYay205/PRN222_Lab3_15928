@page "/veganplaceduylds"
@attribute [Authorize]
@using Vegan.Entities.DuyLD.Models
@using Vegan.Services.DuyLD

@inject IVeganPlaceServiceDuyLd VeganPlaceService

<PageTitle>Vegan Places</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Vegan Places</h1>
        <p class="text-muted mb-0">Manage vegan locations and their availability.</p>
    </div>
    <a class="btn btn-primary" href="veganplaceduylds/create">Create New</a>
</div>

<form class="row g-3 border rounded bg-light p-3 mb-4" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <div class="col-md-4">
        <label class="form-label" for="placeSearch">Place</label>
        <input id="placeSearch" class="form-control" @bind="placeSearch" placeholder="Search by place name" />
    </div>
    <div class="col-md-4">
        <label class="form-label" for="categorySearch">Category</label>
        <input id="categorySearch" class="form-control" @bind="categorySearch" placeholder="Search by category" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="statusSearch">Status</label>
        <select id="statusSearch" class="form-select" @bind="statusSearch">
            <option value="">All</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end gap-2">
        <button class="btn btn-primary" type="submit">Search</button>
        <button class="btn btn-outline-secondary" type="button" @onclick="ClearAsync">Clear</button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">@filteredPlaces.Count result(s)</span>
</div>

<div class="table-responsive border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Place</th>
                <th>Category</th>
                <th>Contact</th>
                <th>Rating</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!PagedPlaces.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No matching places.</td>
                </tr>
            }
            else
            {
                @foreach (var item in PagedPlaces)
                {
                    <tr>
                        <td>@item.VeganPlaceDuyLdid</td>
                        <td>
                            <strong>@item.PlaceName</strong>
                            <div class="small text-muted">@item.Address</div>
                        </td>
                        <td>@item.CategoryName</td>
                        <td>
                            <div>@item.Phone</div>
                            @if (!string.IsNullOrWhiteSpace(item.Website))
                            {
                                <a class="small" href="@item.Website" target="_blank" rel="noopener noreferrer">Website</a>
                            }
                        </td>
                        <td>@(item.Rating?.ToString("0.0") ?? "N/A")</td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="@($"veganplaceduylds/details?veganplaceduyldid={item.VeganPlaceDuyLdid}")">Details</a>
                            <a class="btn btn-sm btn-outline-secondary" href="@($"veganplaceduylds/edit?veganplaceduyldid={item.VeganPlaceDuyLdid}")">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" href="@($"veganplaceduylds/delete?veganplaceduyldid={item.VeganPlaceDuyLdid}")">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (TotalPages > 1)
{
    <nav class="mt-3" aria-label="Vegan place pagination">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button class="page-link" type="button" @onclick="PreviousPage">Previous</button>
            </li>
            @for (var page = 1; page <= TotalPages; page++)
            {
                var pageNumber = page;
                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                    <button class="page-link" type="button" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                </li>
            }
            <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                <button class="page-link" type="button" @onclick="NextPage">Next</button>
            </li>
        </ul>
    </nav>
}

@code {
    private const int PageSize = 5;
    private List<VeganPlaceDuyLd> filteredPlaces = [];
    private string? placeSearch;
    private string? categorySearch;
    private string? statusSearch;
    private int currentPage = 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredPlaces.Count / (double)PageSize));

    private IEnumerable<VeganPlaceDuyLd> PagedPlaces => filteredPlaces
        .Skip((currentPage - 1) * PageSize)
        .Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var isActive = statusSearch switch
        {
            "active" => true,
            "inactive" => false,
            _ => (bool?)null
        };

        var hasSearchCondition = !string.IsNullOrWhiteSpace(placeSearch)
            || !string.IsNullOrWhiteSpace(categorySearch)
            || isActive.HasValue;

        filteredPlaces = hasSearchCondition
            ? await VeganPlaceService.GetAllAsync(placeSearch, categorySearch, isActive)
            : await VeganPlaceService.GetAllAsync();

        currentPage = 1;
    }

    private async Task ClearAsync()
    {
        placeSearch = null;
        categorySearch = null;
        statusSearch = null;
        await SearchAsync();
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void GoToPage(int page)
    {
        currentPage = page;
    }
}

